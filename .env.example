APP_NAME="Portofolio Syahrul Rajabi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Gunakan SQLite (default lokal) atau ubah ke mysql untuk production
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=portfolio_syahrul
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Google Sheets Webhook URL untuk integrasi notifikasi WhatsApp
# Dapatkan URL dari Google Apps Script yang sudah dideploy
GOOGLE_SHEET_WEBHOOK_URL=
